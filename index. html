 <div className="flex items-center justify-between gap-3 mt-2.5"><button type="button" onClick={() => adjustValue('off', -0.1)} className="touch-target w-12 h-12 rounded-xl bg-slate-900 active:bg-slate-800 border border-slate-800 text-slate-200 font-black text-2xl active:scale-90 transition-all shadow">-</button><div className="flex items-baseline gap-1"><input type="number" step="0.1" min="9.0" max="16.0" value={formThresholds.off} onChange={(e) => handleInputChange('off', e.target.value)} className="w-24 text-center text-3xl font-black font-mono bg-transparent text-rose-400 border-b-2 border-slate-700 focus:border-rose-400 focus:outline-none" /><span className="text-sm text-slate-500 font-bold">V</span></div><button type="button" onClick={() => adjustValue('off', 0.1)} className="touch-target w-12 h-12 rounded-xl bg-slate-900 active:bg-slate-800 border border-slate-800 text-slate-200 font-black text-2xl active:scale-90 transition-all shadow">+</button></div>
